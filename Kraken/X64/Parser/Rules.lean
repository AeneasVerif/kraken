notation &"vmovq " lineEq s:x64_rm64            ", " lineEq d:x64_avx_register128 in x64_avx_operation128 => @AvxOperation.vmovIn AvxWidth.W128 Width.W64 d s

notation &"vzeroupper" in x64_avx_operation128 => @AvxOperation.vzeroupper AvxWidth.W128

-- Instructions. All wrappers of the operation categories have the same priority (issue 2).
notation (priority := high) o:x64_operation8                                   in x64_instruction => Instr.regular Width.W64 Width.W8      o
notation                    "." noWs &"byte " 0x67 "; " o:x64_operation8       in x64_instruction => Instr.regular Width.W32 Width.W8      o
notation (priority := high) o:x64_operation16                                  in x64_instruction => Instr.regular Width.W64 Width.W16     o
notation                    "." noWs &"byte " 0x67 "; " o:x64_operation16      in x64_instruction => Instr.regular Width.W32 Width.W16     o
notation (priority := high) o:x64_operation32                                  in x64_instruction => Instr.regular Width.W64 Width.W32     o
notation                    "." noWs &"byte " 0x67 "; " o:x64_operation32      in x64_instruction => Instr.regular Width.W32 Width.W32     o
notation (priority := high) o:x64_operation64                                  in x64_instruction => Instr.regular Width.W64 Width.W64     o
notation                    "." noWs &"byte " 0x67 "; " o:x64_operation64      in x64_instruction => Instr.regular Width.W32 Width.W64     o
notation (priority := high) o:x64_avx_operation128                             in x64_instruction => Instr.avx     Width.W64 AvxWidth.W128 o
notation                    "." noWs &"byte " 0x67 "; " o:x64_avx_operation128 in x64_instruction => Instr.avx     Width.W32 AvxWidth.W128 o
notation (priority := high) o:x64_avx_operation256                             in x64_instruction => Instr.avx     Width.W64 AvxWidth.W256 o
notation                    "." noWs &"byte " 0x67 "; " o:x64_avx_operation256 in x64_instruction => Instr.avx     Width.W32 AvxWidth.W256 o
notation (priority := high) o:x64_avx_operation512                             in x64_instruction => Instr.avx     Width.W64 AvxWidth.W512 o
notation                    "." noWs &"byte " 0x67 "; " o:x64_avx_operation512 in x64_instruction => Instr.avx     Width.W32 AvxWidth.W512 o

notation "." noWs &"align " lineEq a:num                   in x64_instruction => Instr.regular Width.W64 Width.W64 (@Operation.nopalign Width.W64 a none)
notation "." noWs &"align " lineEq a:num ", " lineEq b:num in x64_instruction => Instr.regular Width.W64 Width.W64 (@Operation.nopalign Width.W64 a (some b))

-- Directives
notation (priority := low) i:x64_instruction                     in x64_directive => Kraken.Directive.instr i
notation                   l:x64_ident lineEq ":"                in x64_directive => Kraken.Directive.label l
notation                   "." noWs &"short " lineEq c:x64_const in x64_directive => Kraken.Directive.word 2 c
notation                   "." noWs &"long " lineEq c:x64_const  in x64_directive => Kraken.Directive.word 4 c
notation                   "." noWs &"quad " lineEq c:x64_const  in x64_directive => Kraken.Directive.word 8 c

end
