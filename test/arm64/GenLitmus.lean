import LeanQbe.Arm64.Abi
import LeanQbe.Main
import LeanQbe.Examples.LitmusProgs
import Kraken.AArch64.Print

/-!
Generator of `LeanQbe/Arm64/LitmusCode.lean` (not a module; run with
`lake env lean --run test/arm64/GenLitmus.lean > LeanQbe/Arm64/LitmusCode.lean`).
For each litmus program: the code `compileFn Arm64.isa` produces, as a Kraken `parseAArch64`
literal, the kernel check that the pipeline produces it, and for leaf functions (`callees = []`,
`exits = []`) `compileFn_leaf_correct` instantiated in every AArch64 host containing the code.
-/

open LeanQbe

def progs : List (String × Fn) :=
  [("tracer", Litmus.tracer), ("ifelse", Litmus.ifelse), ("sumto", Litmus.sumto),
   ("evenodd", Litmus.evenodd), ("nested", Litmus.nested), ("swap", Litmus.swap),
   ("inc", Litmus.inc), ("callinc", Litmus.callinc), ("check", Litmus.check),
   ("twice", Litmus.twice), ("spill10", Litmus.spill10), ("sumcall", Litmus.sumcall)]

def header : String := "module

public import LeanQbe.Arm64.Abi
public import LeanQbe.Examples.LitmusProgsLemmas
public import LeanQbe.MainLemmas
public import Kraken.AArch64.Parser

/-!
# Litmus programs on AArch64: compiled code, kernel check, `FnSpec`

GENERATED by `test/arm64/GenLitmus.lean`; do not edit. For each program of
`LeanQbe/Examples/LitmusProgs.lean`: the code the whole pipeline (`compileFn Arm64.isa`: mid-end,
allocation oracle, lowering) produces, written as AArch64 assembly and parsed by Kraken (`…Code`);
the kernel's check that the pipeline produces exactly it (`…_compile`); and for leaf functions
`compileFn_leaf_correct` instantiated in every AArch64 host that contains the code with unique
labels (`…_fnspec`).
-/

set_option autoImplicit false

open Lean Elab Tactic Meta in
/-- Close `lhs = rhs` with `Eq.refl lhs`, checked by the kernel only. -/
elab \"kernel_rfl\" : tactic => do
  let goal ← getMainGoal
  let tgt ← instantiateMVars (← goal.getType)
  let some (α, lhs, _) := tgt.eq?
    | throwError \"kernel_rfl: goal is not an equality{indentExpr tgt}\"
  let u ← getLevel α
  goal.assign (mkApp2 (mkConst ``Eq.refl [u]) α lhs)
  replaceMainGoal []

@[expose] public section

namespace LeanQbe.Arm64.Litmus

open LeanQbe LeanQbe.Litmus Kraken.AArch64.Parser
"

def entry (n : String) (f : Fn) : IO String := do
  match compileFn Arm64.isa f with
  | .error e => throw (IO.userError s!"{n}: {e}")
  | .ok code =>
    let asm := String.intercalate "\n  " (code.map Kraken.AArch64.Print.directive)
    let ns := f.nslots Arm64.isa
    let fs := Arm64.frameSize ns
    let callees := f.opt.ext.callees
    let exits := f.opt.ext.exits
    let base := s!"
def {n}Code : Program := parseAArch64(\"{asm}\")

theorem {n}_compile : compileFn isa {n} = .ok {n}Code := by kernel_rfl

theorem {n}_nslots : {n}.nslots isa = {ns} := by kernel_rfl
theorem {n}_callees : {n}.opt.ext.callees = {repr callees} := by kernel_rfl
theorem {n}_exits : {n}.opt.ext.exits = {repr exits} := by kernel_rfl
"
    if callees.isEmpty && exits.isEmpty then
      return base ++ s!"
theorem {n}_fnspec [hh : Host] (k₀ : Nat) (hc : {n}Code.IsInfixAt Host.prog k₀)
    (hu : Host.LabelsUnique) (Γ : Env) (nX : Nat) :
    target.FnSpec hh {n}.name (Func.spec Γ {n}.body) {fs} nX :=
  compileFn_leaf_correct (T := target) hh {n} Γ {fs} nX {n}Code k₀ {n}_compile hc hu {n}_wf
    {n}_callees {n}_exits (by rw [{n}_nslots]; decide) (by decide)
"
    else
      return base

def footer : String := "
theorem callinc_module_compile :
    compile isa [inc, callinc] = .ok (incCode ++ callincCode) := by kernel_rfl

theorem twice_module_compile :
    compile isa [check, twice] = .ok (checkCode ++ twiceCode) := by kernel_rfl

theorem sumcall_module_compile :
    compile isa [inc, sumcall] = .ok (incCode ++ sumcallCode) := by kernel_rfl

end LeanQbe.Arm64.Litmus
"

def main : IO Unit := do
  IO.print header
  for (n, f) in progs do
    IO.print (← entry n f)
  IO.print footer
