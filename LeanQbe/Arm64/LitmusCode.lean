module

public import LeanQbe.Arm64.Abi
public import LeanQbe.Examples.LitmusProgsLemmas
public import LeanQbe.MainLemmas
public import Kraken.AArch64.Parser

/-!
# Litmus programs on AArch64: compiled code, kernel check, `FnSpec`

GENERATED by `test/arm64/GenLitmus.lean`; do not edit. For each program of
`LeanQbe/Examples/LitmusProgs.lean`: the code the whole pipeline (`compileFn Arm64.isa`: mid-end,
allocation oracle, lowering) produces, written as AArch64 assembly and parsed by Kraken (`…Code`);
the kernel's check that the pipeline produces exactly it (`…_compile`); and `compileFn_correct`
instantiated in every AArch64 host that contains the code with unique labels (`…_fnspec`).
-/

set_option autoImplicit false

open Lean Elab Tactic Meta in
/-- Close `lhs = rhs` with `Eq.refl lhs`, checked by the kernel only. -/
elab "kernel_rfl" : tactic => do
  let goal ← getMainGoal
  let tgt ← instantiateMVars (← goal.getType)
  let some (α, lhs, _) := tgt.eq?
    | throwError "kernel_rfl: goal is not an equality{indentExpr tgt}"
  let u ← getLevel α
  goal.assign (mkApp2 (mkConst ``Eq.refl [u]) α lhs)
  replaceMainGoal []

@[expose] public section

namespace LeanQbe.Arm64.Litmus

open LeanQbe LeanQbe.Litmus Kraken.AArch64.Parser

def tracerCode : Program := parseAArch64("tracer:
  add x0, x0, x1
  str x0, [x2]
  ret")

theorem tracer_compile : compileFn isa tracer = .ok tracerCode := by kernel_rfl

theorem tracer_fnspec [hh : Host] (k₀ : Nat) (hc : tracerCode.IsInfixAt Host.prog k₀)
    (hu : Host.LabelsUnique) (Γ : Env) (nX : Nat) :
    target.FnSpec hh tracer.name (Func.spec Γ tracer.body) 0 nX :=
  compileFn_correct (T := target) hh tracer Γ 0 nX tracerCode k₀ tracer_compile hc hu tracer_wf
    (by decide)

