/-!
# KissatM7Fidelity Native Compilation Certificate on SysV x64

Combines `49` fresh `KissatM7FidelityCert1..49` slices and `38` callee-pruned relinked
`KissatM7PlusCert*` slices via a single-shot `checkLinkList` proof into `m7FidelityCert` over
`LeanQbe.T.Examples.Kissat.FullM7FidelityAssembly.m7FidelityModule.optInlinePolicy m7InlPolicy`
(`413` functions).
-/

set_option autoImplicit false

public section

namespace LeanQbe.T.Amd64.KissatM7FidelityCert

open LeanQbe.T LeanQbe.T.Amd64 LeanQbe.T.Examples.Kissat.FullM7Fidelity
open LeanQbe.T.Amd64.KissatM7FidelityBounds LeanQbe.T.Examples.Kissat.FullM7Plus
open LeanQbe.T.Examples.Kissat.FullM7FidelityInl LeanQbe.T.Examples.Kissat.FullM7InlPolicy
open LeanQbe.T.Examples.Kissat.FullM7PlusInl LeanQbe.T.Examples.Kissat.FullM7FidelityM7PlusBridge

private theorem reuseBaseFns_wf : ∀ f ∈ m7PlusInlFns, f.Wf := by
  have hwf := Module.optInlinePolicy_wf m7InlPolicy m7Plus_acyclic m7PlusFns_wf
  rw [← m7PlusInlMod.eq] at hwf
  exact hwf

eval_raw_callees! rCallees3 x64LegalTarget ((m7PlusInlFns.drop 12).take 12)
eval_pruned_ext! rExt3 rCallees3 (m7FidelityExtPrefix 12)
private theorem rRaw3 :
    checkRawCallsCover x64LegalTarget
      ((m7PlusInlFns.drop 12).take 12) rCallees3 = true := by
  t_kernel_rfl
private theorem rCov3 :
    CalleesCover x64LegalTarget (chunksFns KissatM7PlusCert2.cert2.chunks) rCallees3 := by
  have hc := KissatM7PlusCert2.cert2.fns_eq
  dsimp only [KissatM7PlusCert2.slice2Mod] at hc
  rw [← hc]
  exact calleesCover_of_checkRaw
    (wf_of_take_drop 12 12 reuseBaseFns_wf)
    rRaw3
private theorem rAgree3 :
    checkChunksExtAgreeOn rCallees3
      KissatM7PlusCert2.cert2.chunks rExt3 = true := by
  t_kernel_rfl
private noncomputable def rChunks3 : List (CompiledChunk x64Target x64LegalTarget [] 0) :=
  relinkChunkListCover KissatM7PlusCert2.cert2.chunks rExt3 rCallees3 rCov3 rAgree3
private theorem rMaxB3 :
    chunksMaxBound rChunks3 ≤ 2048 := by
  dsimp only [rChunks3]
  rw [relinkChunkListCover_maxBound]
  exact KissatM7PlusCert2.cert2.maxBound_le

