/-!
# Kissat M2 Unified Fast (`FullFast`) Certificate Slice 6/9 on SysV x64

Kernel-checked native compilation certificate (`cert6`) for slice `[122, 144)` (`22`
functions) of `LeanQbe.T.Examples.Kissat.FullFast.fastFns` on `x64Target`.
-/

set_option autoImplicit false

@[expose] public section

namespace LeanQbe.T.Amd64.KissatFastCert6

open LeanQbe.T LeanQbe.T.Amd64 LeanQbe.T.Examples.Kissat.FullFast

-- Auto-computed callee signatures and stack bounds for prefix.
eval_prefix_ext! ext5 x64Target x64LegalTarget (fastFns.take 122)

/-- Slice 6 sub-module (`[122, 144)`, `22` functions). -/
def slice6Mod : Module := { fns := (fastFns.drop 122).take 22 }

compile_linked_chunks! cert6 x64Target x64Layout x64LegalTarget x64LabelClean
  slice6Mod 4 (ext := ext5) (maxDirs := 450)

end LeanQbe.T.Amd64.KissatFastCert6
