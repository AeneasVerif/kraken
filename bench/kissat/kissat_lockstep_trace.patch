diff --git a/src/search.c b/src/search.c
--- a/src/search.c
+++ b/src/search.c
@@ -23,6 +23,194 @@
 #include "trail.h"
 #include "walk.h"
 
+#ifdef KISSAT_LOCKSTEP_TRACE
+#include "lockstep_trace.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static FILE *g_lt_fp = 0;
+static int g_lt_init = 0;
+static uint64_t g_lt_seq = 0;
+static const char *g_lt_unit_src = 0;
+static const char *g_lt_inproc_src = 0;
+
+static FILE *lt_file (void) {
+  if (!g_lt_init) {
+    g_lt_init = 1;
+    const char *p = getenv ("KISSAT_LOCKSTEP_TRACE");
+    if (p && p[0]) {
+      if (!strcmp (p, "stderr") || !strcmp (p, "-"))
+        g_lt_fp = stderr;
+      else
+        g_lt_fp = fopen (p, "w");
+    }
+  }
+  return g_lt_fp;
+}
+
+static int lt_cmp_i32 (const void *a, const void *b) {
+  int32_t va = *(const int32_t *) a;
+  int32_t vb = *(const int32_t *) b;
+  return (va > vb) - (va < vb);
+}
+
+static int32_t lt_export_lit (kissat *solver, unsigned ilit) {
+  int elit = kissat_export_literal (solver, ilit);
+  if (elit)
+    return (int32_t) elit;
+  int32_t mag = (int32_t) (1000000000u + IDX (ilit));
+  return NEGATED (ilit) ? -mag : mag;
+}
+
+static uint64_t lt_fnv64_lits (kissat *solver, const unsigned *lits, size_t n) {
+  int32_t stack_buf[128];
+  int32_t *buf = stack_buf;
+  if (n > 128)
+    buf = (int32_t *) malloc (n * sizeof (int32_t));
+  for (size_t i = 0; i < n; i++)
+    buf[i] = lt_export_lit (solver, lits[i]);
+  if (n > 1)
+    qsort (buf, n, sizeof (int32_t), lt_cmp_i32);
+  uint64_t h = 14695981039346656037ULL;
+  for (size_t i = 0; i < n; i++) {
+    uint32_t x = (uint32_t) buf[i];
+    for (int b = 0; b < 4; b++) {
+      h ^= (x >> (b * 8)) & 0xffu;
+      h *= 1099511628211ULL;
+    }
+  }
+  if (buf != stack_buf)
+    free (buf);
+  return h;
+}
+
+void kissat_lt_dec (kissat *solver, unsigned lit) {
+  FILE *fp = lt_file ();
+  if (!fp)
+    return;
+  fprintf (fp, "E %" PRIu64 " DEC lvl=%u lit=%d mode=%u\n",
+           g_lt_seq++, solver->level, (int) lt_export_lit (solver, lit),
+           solver->stable ? 1u : 0u);
+}
+
+void kissat_lt_confl (kissat *solver, const clause *c) {
+  FILE *fp = lt_file ();
+  if (!fp || !c || solver->probing)
+    return;
+  uint64_t h = lt_fnv64_lits (solver, c->lits, c->size);
+  fprintf (fp, "E %" PRIu64 " CONFL c=%" PRIu64 " lvl=%u sz=%u hash=%016" PRIx64 "\n",
+           g_lt_seq++, CONFLICTS, solver->level, c->size, h);
+}
+
+void kissat_lt_learn (kissat *solver, unsigned glue,
+                      unsigned jlvl, unsigned nlvl) {
+  FILE *fp = lt_file ();
+  if (!fp || solver->probing)
+    return;
+  const unsigned *lits = BEGIN_STACK (solver->clause);
+  const size_t sz = SIZE_STACK (solver->clause);
+  if (!sz)
+    return;
+  uint64_t h = lt_fnv64_lits (solver, lits, sz);
+  fprintf (fp,
+           "E %" PRIu64 " LEARN c=%" PRIu64 " sz=%zu glue=%u uip=%d"
+           " jlvl=%u nlvl=%u hash=%016" PRIx64 "\n",
+           g_lt_seq++, CONFLICTS, sz, glue, (int) lt_export_lit (solver, lits[0]),
+           jlvl, nlvl, h);
+}
+
+void kissat_lt_rst (kissat *solver, unsigned reuse) {
+  FILE *fp = lt_file ();
+  if (!fp)
+    return;
+  fprintf (fp, "E %" PRIu64 " RST c=%" PRIu64 " reuse=%u mode=%u ticks=%" PRIu64 "\n",
+           g_lt_seq++, CONFLICTS, reuse, solver->stable ? 1u : 0u,
+           solver->statistics.search_ticks);
+}
+
+void kissat_lt_mode (kissat *solver) {
+  FILE *fp = lt_file ();
+  if (!fp)
+    return;
+  fprintf (fp, "E %" PRIu64 " MODE c=%" PRIu64 " to_stable=%u ticks=%" PRIu64 "\n",
+           g_lt_seq++, CONFLICTS, solver->stable ? 1u : 0u,
+           solver->statistics.search_ticks);
+}
+
+void kissat_lt_red (kissat *solver, unsigned del, uint64_t kept) {
+  FILE *fp = lt_file ();
+  if (!fp)
+    return;
+  fprintf (fp, "E %" PRIu64 " RED c=%" PRIu64 " tier1=%u tier2=%u del=%u kept=%" PRIu64 "\n",
+           g_lt_seq++, CONFLICTS, solver->tier1[solver->stable],
+           solver->tier2[solver->stable], del, kept);
+}
+
+void kissat_lt_unit0 (kissat *solver, unsigned lit, unsigned reason) {
+  FILE *fp = lt_file ();
+  if (!fp)
+    return;
+  const char *src = g_lt_unit_src;
+  if (!src)
+    src = g_lt_inproc_src ? g_lt_inproc_src : (reason == UNIT_REASON ? "learn" : "prop");
+  fprintf (fp, "E %" PRIu64 " UNIT0 lit=%d src=%s\n",
+           g_lt_seq++, (int) lt_export_lit (solver, lit), src);
+}
+
+const char *kissat_lt_push_unit_src (const char *src) {
+  const char *prev = g_lt_unit_src;
+  g_lt_unit_src = src ? src : (g_lt_inproc_src ? g_lt_inproc_src : "learn");
+  return prev;
+}
+
+void kissat_lt_pop_unit_src (const char *prev) {
+  g_lt_unit_src = prev;
+}
+
+const char *kissat_lt_enter_inproc (kissat *solver, const char *pass,
+                                    uint64_t *u0, uint64_t *b0, uint64_t *e0) {
+  (void) pass;
+  *u0 = (uint64_t) SIZE_ARRAY (solver->trail);
+  *b0 = BINARY_CLAUSES;
+  *e0 = solver->statistics.eliminated;
+  const char *prev = g_lt_inproc_src;
+  g_lt_inproc_src = pass;
+  return prev;
+}
+
+void kissat_lt_leave_inproc (kissat *solver, const char *pass,
+                             const char *prev, uint64_t u0, uint64_t b0, uint64_t e0) {
+  g_lt_inproc_src = prev;
+  FILE *fp = lt_file ();
+  if (!fp)
+    return;
+  int64_t du = (int64_t) SIZE_ARRAY (solver->trail) - (int64_t) u0;
+  int64_t db = (int64_t) BINARY_CLAUSES - (int64_t) b0;
+  int64_t de = (int64_t) solver->statistics.eliminated - (int64_t) e0;
+  fprintf (fp,
+           "E %" PRIu64 " INPROC c=%" PRIu64 " pass=%s units=%" PRId64
+           " bins=%" PRId64 " elim=%" PRId64 " ticks=%" PRIu64 "\n",
+           g_lt_seq++, CONFLICTS, pass, du, db, de,
+           solver->statistics.search_ticks);
+}
+
+void kissat_lt_end (kissat *solver, int res) {
+  FILE *fp = lt_file ();
+  if (!fp)
+    return;
+  fprintf (fp,
+           "E %" PRIu64 " END status=%d conflicts=%" PRIu64 " decisions=%" PRIu64
+           " props=%" PRIu64 " ticks=%" PRIu64 "\n",
+           g_lt_seq++, res, CONFLICTS, DECISIONS,
+           solver->statistics.propagations, solver->statistics.search_ticks);
+  fflush (fp);
+  if (fp != stderr)
+    fclose (fp);
+  g_lt_fp = 0;
+}
+#endif
+
 #include <inttypes.h>
 
